local function actualizarBotonAutoGol(
    enabled,
    instant
)
    local targetButton =
        enabled
        and Color3.fromRGB(
            0,
            110,
            200
        )
        or Color3.fromRGB(
            25,
            34,
            49
        )

    local targetStroke =
        enabled
        and Color3.fromRGB(
            40,
            190,
            255
        )
        or Color3.fromRGB(
            70,
            85,
            110
        )

    local targetText =
        enabled
        and "AUTOGOL • ACTIVO"
        or "AUTOGOL • PAUSADO"

    local targetPosition =
        enabled
        and UDim2.fromOffset(
            113,
            15
        )
        or UDim2.fromOffset(
            9,
            15
        )

    toggle.Text = targetText

    if instant then
        toggle.BackgroundColor3 =
            targetButton

        toggleStroke.Color =
            targetStroke

        toggleDot.Position =
            targetPosition
    else
        TweenService:Create(
            toggle,
            TweenInfo.new(
                0.16,
                Enum.EasingStyle.Quad,
                Enum.EasingDirection.Out
            ),
            {
                BackgroundColor3 =
                    targetButton
            }
        ):Play()

        TweenService:Create(
            toggleStroke,
            TweenInfo.new(
                0.16,
                Enum.EasingStyle.Quad,
                Enum.EasingDirection.Out
            ),
            {
                Color =
                    targetStroke
            }
        ):Play()

        TweenService:Create(
            toggleDot,
            TweenInfo.new(
                0.16,
                Enum.EasingStyle.Quad,
                Enum.EasingDirection.Out
            ),
            {
                Position =
                    targetPosition
            }
        ):Play()
    end

    statusDot.BackgroundColor3 =
        enabled
        and Color3.fromRGB(
            65,
            230,
            145
        )
        or Color3.fromRGB(
            110,
            120,
            135
        )
end

