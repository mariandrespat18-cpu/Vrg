-- BUY SYSTEM
--==================================================

local instantEnabled = false
local autoBuyEnabled = false
local buyLoop = nil

-- SOLO ESTAS PALABRAS
local BUY_WORDS = {
    "comprar",
    "purchase",
    "purch",
    "compr",
    "buy"
}

local function isAllowedBuyText(text)
    if not text then
        return false
    end

    text = string.lower(tostring(text))

    for _, word in ipairs(BUY_WORDS) do
        if text:find(word, 1, true) then
            return true
        end
    end

    return false
end

local function isBuyPrompt(prompt)
    if not prompt
        or not prompt:IsA("ProximityPrompt") then
        return false
    end

    -- Solo ActionText, ObjectText y Name.
    return isAllowedBuyText(prompt.ActionText)
        or isAllowedBuyText(prompt.ObjectText)
        or isAllowedBuyText(prompt.Name)
end

local function makePromptInstant(prompt)
    if not prompt
        or not prompt:IsA("ProximityPrompt") then
        return
    end

    pcall(function()
        prompt.HoldDuration = 0
    end)
end

local function firePrompt(prompt)
    if not prompt
        or not prompt.Parent
        or not prompt.Enabled
        or not isBuyPrompt(prompt) then

        return false
    end

    if typeof(fireproximityprompt) ~= "function" then
        return false
    end

    local success = pcall(function()
        fireproximityprompt(prompt)
    end)

    if not success then
        pcall(function()
            fireproximityprompt(prompt, 0)
        end)
    end

    return success
end

local function processBuyPrompt(prompt)
    if not isBuyPrompt(prompt) then
        return
    end

    if instantEnabled then
        makePromptInstant(prompt)
    end

    if autoBuyEnabled then
        firePrompt(prompt)
    end
end

local function startBuyLoop()
    if buyLoop then
        return
    end

    buyLoop = RunService.Heartbeat:Connect(function()
        if not instantEnabled and not autoBuyEnabled then
            return
        end

        for _, prompt in ipairs(Workspace:GetDescendants()) do
            if prompt:IsA("ProximityPrompt") then
                processBuyPrompt(prompt)
            end
        end
    end)
end

local function stopBuyLoop()
    if buyLoop then
        buyLoop:Disconnect()
        buyLoop = nil
    end
end

