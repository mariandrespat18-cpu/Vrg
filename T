--==================================================
-- FPS BOOSTER
--==================================================

local boosterEnabled = false

local OriginalTransparency = setmetatable({}, {
    __mode = "k"
})

local ultraThreads = {}
local ultraConnections = {}

local INITIAL_BATCH_SIZE = 200
local NEW_OBJECT_BATCH_SIZE = 30
local NEW_OBJECT_DELAY = 0.10

local pendingObjects = {}
local pendingSet = setmetatable({}, {
    __mode = "k"
})

local queueProcessing = false

local function AddThread(thread)
    if thread then
        table.insert(ultraThreads, thread)
    end
end

local function AddConnection(connection)
    if connection then
        table.insert(ultraConnections, connection)
    end
end

local function DisconnectAll()
    for i = #ultraConnections, 1, -1 do
        local connection = ultraConnections[i]

        pcall(function()
            connection:Disconnect()
        end)
    end

    table.clear(ultraConnections)
end

local function CancelAll()
    for i = #ultraThreads, 1, -1 do
        pcall(function()
            task.cancel(ultraThreads[i])
        end)
    end

    table.clear(ultraThreads)
end

local function ClearPending()
    table.clear(pendingObjects)
    table.clear(pendingSet)
end

local function QueueObject(obj)
    if not boosterEnabled then
        return
    end

    if not obj or not obj.Parent then
        return
    end

    if pendingSet[obj] then
        return
    end

    pendingSet[obj] = true
    pendingObjects[#pendingObjects + 1] = obj
end

local function IsProtected(obj)
    local parent = obj

    while parent and parent ~= Workspace do
        local n = parent.Name

        if n == "Debris"
            or n == "FastOverheadTemplate"
            or n == "AnimalOverhead" then
            return true
        end

        parent = parent.Parent
    end

    return false
end

local function IsClothing(obj)
    return obj:IsA("Shirt")
        or obj:IsA("Pants")
        or obj:IsA("ShirtGraphic")
        or obj:IsA("Accessory")
end

local function IsCharacterPart(obj)
    local parent = obj

    while parent and parent ~= Workspace do
        if parent:IsA("Model")
            and Players:GetPlayerFromCharacter(parent) then
            return true
        end

        parent = parent.Parent
    end

    return false
end

local BASE_NAMES = {
    ["baseplate"] = true,
    ["spawnlocation"] = true,
    ["spawn location"] = true,
    ["spawn"] = true
}

local function IsBase(obj)
    if not obj:IsA("BasePart") then
        return false
    end

    local n = obj.Name:lower()

    if BASE_NAMES[n] then
        return true
    end

    for name in pairs(BASE_NAMES) do
        if n:find(name, 1, true) then
            return true
        end
    end

    return false
end

local function IsInBase(obj)
    local parent = obj.Parent

    while parent and parent ~= Workspace do
        if IsBase(parent) then
            return true
        end

        parent = parent.Parent
    end

    return false
end

local function IsOutOfRange(obj)
    if not obj:IsA("BasePart") then
        return false
    end

    local x = obj.Position.X

    return x < -560 or x > -240
end

local function MakeTransparent(obj)
    if not IsBase(obj) then
        return
    end

    if IsCharacterPart(obj) then
        return
    end

    pcall(function()
        if OriginalTransparency[obj] == nil then
            OriginalTransparency[obj] = {
                transparency = obj.Transparency,
                shadow = obj.CastShadow
            }
        end

        obj.Transparency = 1
        obj.CastShadow = false
    end)
end

local function SafeDestroy(obj)
    if not obj then
        return
    end

    local name = obj.Name

    if name == "Overhead"
        or name == "AnimalOverhead"
        or name == "Generation"
        or name == "DisplayName"
        or name == "FastOverheadTemplate" then
        return
    end

    pcall(function()
        if obj.Parent then
            obj:Destroy()
        end
    end)
end

local function OptimizeObject(obj)
    if not boosterEnabled then
        return
    end

    if not obj or not obj.Parent then
        return
    end

    if IsProtected(obj) then
        return
    end

    if IsCharacterPart(obj) then
        return
    end

    if IsClothing(obj) then
        return
    end

    if IsBase(obj) then
        MakeTransparent(obj)
        return
    end

    if IsInBase(obj) then
        return
    end

    if IsOutOfRange(obj) then
        SafeDestroy(obj)
        return
    end

    if obj:IsA("SurfaceAppearance")
        or obj:IsA("SpecialMesh")
        or obj:IsA("Texture") then

        SafeDestroy(obj)
        return
    end

    if obj:IsA("Decal") then
        if obj.Name == "face"
            and obj.Parent
            and obj.Parent.Name == "Head" then
            return
        end

        SafeDestroy(obj)
        return
    end

    if obj:IsA("ParticleEmitter")
        or obj:IsA("Trail")
        or obj:IsA("Beam")
        or obj:IsA("Smoke")
        or obj:IsA("Fire")
        or obj:IsA("Sparkles") then

        SafeDestroy(obj)
        return
    end

    if obj:IsA("PointLight")
        or obj:IsA("SpotLight")
        or obj:IsA("SurfaceLight") then

        SafeDestroy(obj)
        return
    end

    if obj:IsA("Explosion")
        or obj:IsA("Animation")
        or obj:IsA("AnimationController") then

        SafeDestroy(obj)
        return
    end

    if obj:IsA("BasePart") then
        pcall(function()
            obj.CastShadow = false
            obj.Material = Enum.Material.Plastic
            obj.MaterialVariant = ""
            obj.Reflectance = 0
        end)
    end
end

local function ProcessQueue()
    if queueProcessing then
        return
    end

    queueProcessing = true

    local thread = task.spawn(function()
        while boosterEnabled do
            local processed = 0

            while processed < NEW_OBJECT_BATCH_SIZE
                and #pendingObjects > 0
                and boosterEnabled do

                local obj = table.remove(pendingObjects, 1)

                if obj then
                    pendingSet[obj] = nil

                    if obj.Parent then
                        OptimizeObject(obj)
                    end
                end

                processed += 1
            end

            if #pendingObjects > 0 then
                task.wait(NEW_OBJECT_DELAY)
            else
                task.wait(0.25)
            end
        end

        queueProcessing = false
    end)

    AddThread(thread)
end

local function ProcessInitial()
    local objects = Workspace:GetDescendants()
    local total = #objects

    for start = 1, total, INITIAL_BATCH_SIZE do
        if not boosterEnabled then
            break
        end

        local finish = math.min(
            start + INITIAL_BATCH_SIZE - 1,
            total
        )

        for i = start, finish do
            local obj = objects[i]

            if obj and obj.Parent then
                OptimizeObject(obj)
            end
        end

        if finish < total then
            task.wait()
        end
    end

    table.clear(objects)
end

local function ApplyGreySky()
    pcall(function()
        for _, obj in ipairs(Lighting:GetChildren()) do
            if obj:IsA("Sky") then
                obj:Destroy()
            end
        end

        local sky = Instance.new("Sky")
        sky.SkyboxBk = ""
        sky.SkyboxDn = ""
        sky.SkyboxFt = ""
        sky.SkyboxLf = ""
        sky.SkyboxRt = ""
        sky.SkyboxUp = ""
        sky.CelestialBodiesShown = false
        sky.Parent = Lighting
    end)
end

local function OptimizeLighting()
    pcall(function()
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 9e9
        Lighting.FogStart = 9e9

        Lighting.EnvironmentDiffuseScale = 0
        Lighting.EnvironmentSpecularScale = 0

        Lighting.Brightness = 1.5
        Lighting.Ambient = Color3.fromRGB(60, 60, 60)
    end)

    for _, obj in ipairs(Lighting:GetChildren()) do
        if obj:IsA("PostEffect") then
            pcall(function()
                obj.Enabled = false
            end)
        elseif obj:IsA("Atmosphere")
            or obj:IsA("Clouds") then
            SafeDestroy(obj)
        end
    end

    ApplyGreySky()
end

local function OptimizeTerrain()
    pcall(function()
        local terrain = Workspace.Terrain

        terrain.Decoration = false
        terrain.WaterWaveSize = 0
        terrain.WaterWaveSpeed = 0
        terrain.WaterReflectance = 0
        terrain.WaterTransparency = 1
    end)
end

local function RestoreFPS()
    ClearPending()

    pcall(function()
        for part, data in pairs(OriginalTransparency) do
            if part and part.Parent then
                part.Transparency = data.transparency
                part.CastShadow = data.shadow
            end
        end
    end)

    table.clear(OriginalTransparency)

    pcall(function()
        settings().Rendering.QualityLevel =
            Enum.QualityLevel.Automatic

        settings().Rendering.MeshPartDetailLevel =
            Enum.MeshPartDetailLevel.Automatic
    end)

    pcall(function()
        Lighting.GlobalShadows = true
        Lighting.Brightness = 2
        Lighting.FogEnd = 100000
        Lighting.FogStart = 0

        Lighting.EnvironmentDiffuseScale = 1
        Lighting.EnvironmentSpecularScale = 1
    end)

    pcall(function()
        local terrain = Workspace.Terrain

        terrain.WaterWaveSize = 0.15
        terrain.WaterWaveSpeed = 1
        terrain.WaterReflectance = 0.5
        terrain.WaterTransparency = 0.3
        terrain.Decoration = true
    end)
