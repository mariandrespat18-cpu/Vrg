local promptAddedConnection

promptAddedConnection = Workspace.DescendantAdded:Connect(function(obj)
    if not obj:IsA("ProximityPrompt") then
        return
    end

    task.defer(function()
        if not obj or not obj.Parent then
            return
        end

        if not isBuyPrompt(obj) then
            return
        end

        if instantEnabled then
            makePromptInstant(obj)
        end

        if autoBuyEnabled then
            firePrompt(obj)

            task.spawn(function()
                for _ = 1, 15 do
                    if not autoBuyEnabled
                        or not obj
                        or not obj.Parent
                        or not obj.Enabled then
                        break
                    end

                    -- Comprobar nuevamente por seguridad
                    if not isBuyPrompt(obj) then
                        break
                    end

                    firePrompt(obj)
                    task.wait(0.08)
                end
            end)
        end
    end)
end)

