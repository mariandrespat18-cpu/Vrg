local function SetFPSBoost(enabled)
    if boosterEnabled == enabled then
        return
    end

    boosterEnabled = enabled

    DisconnectAll()
    CancelAll()

    queueProcessing = false

    if not enabled then
        RestoreFPS()
        return
    end

    pcall(function()
        settings().Rendering.QualityLevel =
            Enum.QualityLevel.Level01

        settings().Rendering.MeshPartDetailLevel =
            Enum.MeshPartDetailLevel.Level01

        settings().Physics.AllowSleep = true
        settings().Physics.PhysicsEnvironmentalThrottle = 1
    end)

    if type(setfpscap) == "function" then
        pcall(setfpscap, 0)
    end

    OptimizeLighting()
    OptimizeTerrain()

    AddThread(
        task.spawn(ProcessInitial)
    )

    AddConnection(
        Workspace.DescendantAdded:Connect(function(obj)
            if not boosterEnabled then
                return
            end

            QueueObject(obj)

            if not queueProcessing then
                ProcessQueue()
            end
        end)
    )

    AddConnection(
        Lighting.DescendantAdded:Connect(function(obj)
            if not boosterEnabled then
                return
            end

            if obj:IsA("PostEffect") then
                pcall(function()
                    obj.Enabled = false
                end)
            elseif obj:IsA("Atmosphere")
                or obj:IsA("Clouds") then
                SafeDestroy(obj)
            end
        end)
    )

    AddConnection(
        MaterialService.DescendantAdded:Connect(function(obj)
            if boosterEnabled then
                SafeDestroy(obj)
            end
        end)
    )
end

createToggle("FPS Booster", function(state)
    pcall(function()
        SetFPSBoost(state)
    end)
end)

