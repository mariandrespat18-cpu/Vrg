-- 5. AUTO COMPRAR
local autoClickEnabled = false
local autoClickConns = {}

local function isBuyPrompt(prompt)
    local action = string.lower(prompt.ActionText or "")
    local objText = string.lower(prompt.ObjectText or "")
    return action:find("compr") or action:find("buy") or objText:find("compr") or objText:find("buy")
end

local function connectPrompt(prompt)
    if prompt:IsA("ProximityPrompt") then
        local conn = prompt.PromptShown:Connect(function()
            if autoClickEnabled and isBuyPrompt(prompt) then
                task.spawn(function()
                    while autoClickEnabled and prompt and prompt.Parent and prompt.Enabled do
                        pcall(function() fireproximityprompt(prompt) end)
                        task.wait(0.1)
                    end
                end)
            end
        end)
        table.insert(autoClickConns, conn)
    end
end

createToggle("Auto Comprar", function(state)
    autoClickEnabled = state
    for _, c in ipairs(autoClickConns) do c:Disconnect() end
    autoClickConns = {}

    if state then
        for _, v in ipairs(Workspace:GetDescendants()) do connectPrompt(v) end
        table.insert(autoClickConns, Workspace.DescendantAdded:Connect(connectPrompt))
    end
end)

-- 6. FREEZE
local freezeConn
local savedSpeed = 16
createToggle("Freeze", function(state)
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")

    if not hum or not root then return end

    if state then
        savedSpeed = hum.WalkSpeed
        hum.WalkSpeed = 0
        hum.JumpPower = 0
        root.Anchored = true
        freezeConn = RunService.Heartbeat:Connect(function()
            if root and root.Parent then
                root.Velocity = Vector3.zero
                root.RotVelocity = Vector3.zero
            end
        end)
    else
        hum.WalkSpeed = savedSpeed
        hum.JumpPower = 50
        root.Anchored = false
        if freezeConn then freezeConn:Disconnect() freezeConn = nil end
    end
end)

