addConnection(
    RunService.Heartbeat,
    function()
        if _G.TokiLTM_Stop then
            return
        end

        if Config.JumpDown then
            correctExternalDisplacement()
        end

        if antiRagdollRunning then
            protectRagdoll(
                getCharacter()
            )
        end

        if antiDieRunning then
            local hum =
                getHumanoid()

            if hum then
                pcall(function()
                    if hum.Health <
                        hum.MaxHealth
                    then
                        hum.Health =
                            hum.MaxHealth
                    end
                end)
            end
        end

        if Config.HoldJump then
            local hum =
                getHumanoid()

            local root =
                getRoot()

            if
                hum
                and
                root
                and
                hum.Jump
            then
                local speed =
                    tonumber(
                        Config.HoldJumpSpeed
                    )
                    or
                    DEFAULT_HOLD_JUMP_SPEED

                speed =
                    math.max(
                        0,
                        speed
                    )

                pcall(function()
                    root.AssemblyLinearVelocity =
                        Vector3.new(
                            root.AssemblyLinearVelocity.X,
                            speed,
                            root.AssemblyLinearVelocity.Z
                        )
                end)
            end
        end
    end
)

local animTime = 0

addConnection(
    RunService.RenderStepped,
    function(dt)
        if _G.TokiLTM_Stop then
            return
        end

        animTime += dt

        local wave =
            (
                math.sin(
                    animTime *
                    2.3
                )
                + 1
            )
            / 2

        local blue =
            Color3.fromRGB(
                0,
                math.floor(
                    175 +
                    wave *
                    45
                ),
                255
            )

        local cyan =
            Color3.fromRGB(
                0,
                math.floor(
                    205 +
                    wave *
                    25
                ),
                255
            )

        mainStroke.Color =
            blue

        minStroke.Color =
            cyan

        settingsStroke.Color =
            blue

        title.TextColor3 =
            cyan

        titleDot.BackgroundColor3 =
            blue

        subtitle.TextColor3 =
            blue

        topGlow.BackgroundColor3 =
            cyan

        footer.TextColor3 =
            blue

        headerLine.BackgroundColor3 =
            blue

        minButton.TextColor3 =
            cyan

        headerGradient.Offset =
            Vector2.new(
                math.sin(
                    animTime *
                    0.7
                )
                *
                0.35,
                0
            )

        mainGradient.Offset =
            Vector2.new(
                math.sin(
                    animTime *
                    0.25
                )
                *
                0.08,
                0
            )

        settingsGradient.Offset =
            Vector2.new(
                math.sin(
                    animTime *
                    0.28
                )
                *
                0.08,
                0
            )

        local pulse =
            1.7 +
            math.sin(
                animTime *
                2.2
            )
            *
            0.7

        mainStroke.Thickness =
            pulse

        for _, panel in ipairs(
            panels
        ) do
            panel.Stroke.Color =
                blue

            panel.ToggleStroke.Color =
                cyan

            panel.KnobGlow.Color =
                blue

            panel.IconStroke.Color =
                blue

            panel.IconCore.BackgroundColor3 =
                cyan

            if panel.Gear then
                local gearStroke =
                    panel.Gear:FindFirstChildOfClass(
                        "UIStroke"
                    )

                if gearStroke then
                    gearStroke.Color =
                        blue
                end

                panel.Gear.TextColor3 =
                    cyan
            end
        end

        for _, row in ipairs(
            settingsRows
        ) do
            row.Label.TextColor3 =
                blue

            row.Stroke.Color =
                blue

            row.InputStroke.Color =
                cyan

            row.Input.TextColor3 =
                cyan
        end

        updateStatus()

        local now =
            os.clock()

        for _, data in ipairs(
            snowflakes
        ) do
            local flake =
                data.Object

            local pos =
                flake.Position

            local drift =
                math.sin(
                    now *
                    1.5 +
                    data.Phase
                )
                *
                0.00012

            local newX =
                pos.X.Scale +
                data.Drift *
                dt *
                110 +
                drift

            local newY =
                pos.Y.Scale +
                data.Speed *
                dt

            if newY > 1.08 then
                newY = -0.08
                newX =
                    math.random()
            end

            if newX > 1.05 then
                newX = -0.05
            elseif newX < -0.05 then
                newX = 1.05
            end

            flake.Position =
                UDim2.new(
                    newX,
                    0,
                    newY,
                    0
                )

            flake.Rotation =
                (
                    now *
                    data.RotationSpeed +
                    data.Phase *
                    25
                )
                %
                360

            local visibility =
                (
                    math.sin(
                        now *
                        2 +
                        data.Phase
                    )
                    + 1
                )
                / 2

            for _, arm in ipairs(
                flake:GetChildren()
            ) do
                if arm:IsA("Frame") then
                    arm.BackgroundColor3 =
                        cyan

                    arm.BackgroundTransparency =
                        0.12 +
                        visibility *
                        0.34
                end
            end
        end
    end
)

