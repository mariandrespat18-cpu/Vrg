        input

    local inputStroke =
        Instance.new("UIStroke")

    inputStroke.Thickness = 1
    inputStroke.Transparency = 0.22
    inputStroke.Parent =
        input

    local function setText(value)
        if decimals == 0 then
            input.Text =
                tostring(
                    math.floor(
                        value + 0.5
                    )
                )
        else
            input.Text =
                string.format(
                    "%."
                    ..
                    decimals
                    ..
                    "f",
                    value
                )
        end
    end

    local function apply()
        local fallback =
            tonumber(
                Config.JumpDownSettings[key]
            )
            or
            DEFAULT_JUMP_SETTINGS[key]

        local value =
            tonumber(
                input.Text
            )

        if not value then
            value = fallback
        end

        value =
            math.clamp(
                value,
                minValue,
                maxValue
            )

        Config.JumpDownSettings[key] =
            value

        setText(value)
    end

    setText(
        tonumber(
            Config.JumpDownSettings[key]
        )
        or
        DEFAULT_JUMP_SETTINGS[key]
    )

    addConnection(
        input.FocusLost,
        function()
            apply()
            saveConfig()
        end
    )

    table.insert(
        settingsRows,
        {
            General = false,
            Key = key,
            Input = input,
            Label = label,
            Stroke = stroke,
            InputStroke = inputStroke,
            Row = row,
            Apply = apply,
            SetText = setText
        }
    )

    return row
end

