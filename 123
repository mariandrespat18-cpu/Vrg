local function performJumpDown(
    targetCFrame
)
    if _G.TokiLTM_Stop then
        return
    end

    if not targetCFrame then
        return
    end

    local root = getRoot()
    local hum = getHumanoid()

    if not root or not hum then
        return
    end

    if isManualMovement() then
        return
    end

    local settings =
        Config.JumpDownSettings

    local height =
        math.clamp(
            tonumber(settings.Height)
                or 7,
            1,
            25
        )

    local upSpeed =
        math.clamp(
            tonumber(settings.UpSpeed)
                or 38,
            5,
            100
        )

    local fallSpeed =
        math.clamp(
            tonumber(settings.FallSpeed)
                or 250,
            50,
            600
        )

    local upTime =
        math.clamp(
            tonumber(settings.UpTime)
                or 0.16,
            0.05,
            0.5
        )

    local maxFallTime =
        math.clamp(
            tonumber(settings.MaxFallTime)
                or 0.80,
            0.2,
            2
        )

    if Config.AntiRagdoll then
        protectRagdoll(
            getCharacter()
        )
    end

    local _, yaw =
        targetCFrame:ToOrientation()

    local horizontal =
        Vector3.new(
            root.AssemblyLinearVelocity.X,
            0,
            root.AssemblyLinearVelocity.Z
        )

    local elevated =
        CFrame.new(
            targetCFrame.Position
                +
                Vector3.new(
                    0,
                    height,
                    0
                )
        )
        *
        CFrame.Angles(
            0,
            yaw,
            0
        )

    pcall(function()
        root.CFrame =
            elevated

        root.AssemblyAngularVelocity =
            Vector3.zero

        root.AssemblyLinearVelocity =
            Vector3.new(
                horizontal.X,
                upSpeed,
                horizontal.Z
            )

        hum.PlatformStand = false

        hum:ChangeState(
            Enum.HumanoidStateType.Jumping
        )
    end)

    task.wait(upTime)

    if _G.TokiLTM_Stop then
        return
    end

    if isManualMovement() then
        return
    end

    root =
        getRoot()

    hum =
        getHumanoid()

    if not root or not hum then
        return
    end

    pcall(function()
        root.AssemblyAngularVelocity =
            Vector3.zero

        root.AssemblyLinearVelocity =
            Vector3.new(
                root.AssemblyLinearVelocity.X,
                -fallSpeed,
                root.AssemblyLinearVelocity.Z
            )

        hum.PlatformStand = false

        hum:ChangeState(
            Enum.HumanoidStateType.Freefall
        )
    end)

    local start =
        os.clock()

    while
        os.clock() - start <
        maxFallTime
    do
        if _G.TokiLTM_Stop then
            return
        end

        if isManualMovement() then
            return
        end

        root =
            getRoot()

        hum =
            getHumanoid()

        if not root or not hum then
            return
        end

        if Config.AntiRagdoll then
            protectRagdoll(
                getCharacter()
            )
        end

        pcall(function()
            root.AssemblyAngularVelocity =
                Vector3.zero
        end)

        if hum.FloorMaterial ~=
            Enum.Material.Air
        then
            break
        end

        RunService.Heartbeat:Wait()
    end

    root =
        getRoot()

    hum =
        getHumanoid()

    if root
        and
        hum
        and
        not isManualMovement()
    then
        pcall(function()
            root.AssemblyAngularVelocity =
                Vector3.zero

            root.CFrame =
                CFrame.new(
                    targetCFrame.Position
                )
                *
                CFrame.Angles(
                    0,
                    yaw,
                    0
                )

            root.AssemblyLinearVelocity =
                Vector3.zero

            hum.PlatformStand = false

            if Config.AntiRagdoll then
                hum:ChangeState(
                    Enum.HumanoidStateType.GettingUp
                )
            end
        end)
    end
end

local function startJumpDown()
    if jumpDownRunning then
        return
    end

    jumpDownRunning = true

    if not jumpDownAnchorCFrame then
        captureJumpDownAnchor()
    end

    task.spawn(function()
        while
            Config.JumpDown
            and
            not Config.Farmer
            and
            not _G.TokiLTM_Stop
        do
            local root =
                getRoot()

            local hum =
                getHumanoid()

            if not root or not hum then
                task.wait(0.15)
                continue
            end

            if isManualMovement() then
                jumpDownManualMoving = true

                updateJumpDownAnchorFromMovement()

                task.wait(0.08)
                continue
            end

            if jumpDownManualMoving then
                jumpDownManualMoving = false

                captureJumpDownAnchor()
            end

            if not jumpDownAnchorCFrame then
                captureJumpDownAnchor()
            end

            if isManualMovement() then
                continue
            end

            local target =
                jumpDownAnchorCFrame

            performJumpDown(
                target
            )

            if isManualMovement() then
                jumpDownManualMoving = true

                updateJumpDownAnchorFromMovement()

                continue
            end

            local currentRoot =
                getRoot()

            if
                currentRoot
                and
                jumpDownAnchorCFrame
                and
                not isManualMovement()
            then
                pcall(function()
                    local _, yaw =
                        jumpDownAnchorCFrame:ToOrientation()

                    currentRoot.CFrame =
                        CFrame.new(
                            jumpDownAnchorCFrame.Position
                        )
                        *
                        CFrame.Angles(
                            0,
                            yaw,
                            0
                        )

                    currentRoot.AssemblyAngularVelocity =
                        Vector3.zero

                    currentRoot.AssemblyLinearVelocity =
                        Vector3.zero
                end)
            end

            task.wait(0.08)
        end

        jumpDownRunning = false
        jumpDownManualMoving = false
    end)
end

local function getFarmerCFrame()
    if not farmerPosition
        or
        not farmerRotation
    then
        return nil
    end

    return
        CFrame.new(
            farmerPosition
        )
        *
        farmerRotation
end

local function startFarmer()
    if farmerRunning then
        return
    end

    local root =
        getRoot()

    if not root then
        Config.Farmer = false
        return
    end

    farmerPosition =
        root.Position

    local _, yaw =
        root.CFrame:ToOrientation()

    farmerRotation =
        CFrame.Angles(
            0,
            yaw,
            0
        )

    farmerRunning = true

    task.spawn(function()
        while
            Config.Farmer
            and
            not _G.TokiLTM_Stop
        do
            local target =
                getFarmerCFrame()

            if target then
                local currentRoot =
                    getRoot()

                if currentRoot then
                    pcall(function()
                        currentRoot.CFrame =
                            target

                        currentRoot.AssemblyAngularVelocity =
                            Vector3.zero

                        currentRoot.AssemblyLinearVelocity =
                            Vector3.zero
                    end)

                    performJumpDown(
                        target
                    )

                    currentRoot =
                        getRoot()

                    if currentRoot then
                        pcall(function()
                            currentRoot.CFrame =
                                target

                            currentRoot.AssemblyAngularVelocity =
                                Vector3.zero

                            currentRoot.AssemblyLinearVelocity =
                                Vector3.zero
                        end)
                    end
                end
            end

            task.wait(0.12)
        end

        farmerRunning = false
    end)
end

local function stopFarmer()
    Config.Farmer = false
    farmerPosition = nil
    farmerRotation = nil
end

