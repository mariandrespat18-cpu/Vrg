        UpSpeed = DEFAULT_JUMP_SETTINGS.UpSpeed,
        FallSpeed = DEFAULT_JUMP_SETTINGS.FallSpeed,
        UpTime = DEFAULT_JUMP_SETTINGS.UpTime,
        MaxFallTime = DEFAULT_JUMP_SETTINGS.MaxFallTime
    }
end

local function saveConfig()
    if type(writefile) ~= "function" then
        return
    end

    pcall(function()
        writefile(
            CONFIG_FILE,
            HttpService:JSONEncode(Config)
        )
    end)
end

local function loadConfig()
    if type(isfile) ~= "function" then
        return
    end

    if not isfile(CONFIG_FILE) then
        return
    end

    local ok, data = pcall(function()
        return HttpService:JSONDecode(
            readfile(CONFIG_FILE)
        )
    end)

    if not ok or type(data) ~= "table" then
        return
    end

    if type(data.Position) == "table" then
        Config.Position.XScale =
            tonumber(data.Position.XScale)
            or Config.Position.XScale

        Config.Position.XOffset =
            tonumber(data.Position.XOffset)
            or Config.Position.XOffset

        Config.Position.YScale =
            tonumber(data.Position.YScale)
            or Config.Position.YScale

        Config.Position.YOffset =
            tonumber(data.Position.YOffset)
            or Config.Position.YOffset
    end

    if type(data.JumpDown) == "boolean" then
        Config.JumpDown = data.JumpDown
    end

    if type(data.Farmer) == "boolean" then
        Config.Farmer = data.Farmer
    end

    if type(data.HoldJump) == "boolean" then
        Config.HoldJump = data.HoldJump
    end

    if type(data.AntiDie) == "boolean" then
        Config.AntiDie = data.AntiDie
    end

    if type(data.AntiRagdoll) == "boolean" then
        Config.AntiRagdoll = data.AntiRagdoll
    end

    if type(data.HoldJumpSpeed) == "number"
        or type(data.HoldJumpSpeed) == "string"
    then
        local loadedSpeed =
            tonumber(data.HoldJumpSpeed)

        if loadedSpeed then
            Config.HoldJumpSpeed =
                math.max(
                    0,
                    loadedSpeed
                )
        else
            Config.HoldJumpSpeed =
                DEFAULT_HOLD_JUMP_SPEED
        end
    end

    if type(data.Collapsed) == "boolean" then
        Config.Collapsed = data.Collapsed
    end

    if type(data.Visible) == "boolean" then
        Config.Visible = data.Visible
    end

    if type(data.JumpDownSettings) == "table" then
        for key, defaultValue in pairs(
            DEFAULT_JUMP_SETTINGS
        ) do
            Config.JumpDownSettings[key] =
                tonumber(
                    data.JumpDownSettings[key]
                )
                or defaultValue
        end
    else
        Config.JumpDownSettings =
            defaultJumpSettings()
    end
end

loadConfig()

local function cleanup()
    _G.TokiLTM_Stop = true

    for _, connection in ipairs(connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    table.clear(connections)

    for _, tween in ipairs(runningTweens) do
        pcall(function()
            tween:Cancel()
        end)
    end

    table.clear(runningTweens)

    if _G.TokiLTM_GUI then
        pcall(function()
            _G.TokiLTM_GUI:Destroy()
        end)
    end

    if _G.TokiLTM_SettingsGUI then
        pcall(function()
            _G.TokiLTM_SettingsGUI:Destroy()
        end)
    end

    _G.TokiLTM_GUI = nil
    _G.TokiLTM_SettingsGUI = nil
    _G.TokiLTM_Cleanup = nil
end

_G.TokiLTM_Cleanup = cleanup

local function getCharacter()
    return LP.Character
end

local function getHumanoid()
    local character = getCharacter()

    if not character then
        return nil
    end

    return character:FindFirstChildOfClass(
        "Humanoid"
    )
end

local function getRoot()
    local character = getCharacter()

    if not character then
        return nil
    end

    return character:FindFirstChild(
        "HumanoidRootPart"
    )
end

local function isManualMovement()
    local hum = getHumanoid()

    if not hum then
        return false
    end

    return hum.MoveDirection.Magnitude > 0.05
end

local function captureJumpDownAnchor()
    local root = getRoot()

    if not root then
        return
    end

    local _, yaw =
        root.CFrame:ToOrientation()

    jumpDownAnchorCFrame =
        CFrame.new(
            root.Position
        )
        *
        CFrame.Angles(
            0,
            yaw,
            0
        )
end

local function updateJumpDownAnchorFromMovement()
    local root = getRoot()

    if not root then
        return
    end

    local _, yaw =
        root.CFrame:ToOrientation()

    jumpDownAnchorCFrame =
        CFrame.new(
            root.Position
        )
        *
        CFrame.Angles(
            0,
            yaw,
            0
        )
end

local function getHorizontalDistance(
    root,
    target
)
    local current =
        Vector3.new(
            root.Position.X,
            0,
            root.Position.Z
        )

    local targetPosition =
        Vector3.new(
            target.Position.X,
            0,
            target.Position.Z
        )

    return (
        current -
        targetPosition
    ).Magnitude
end

local function correctExternalDisplacement()
    if not Config.JumpDown then
        return
    end

    if not jumpDownAnchorCFrame then
        return
    end

    if jumpDownManualMoving then
        return
    end

    local root = getRoot()

    if not root then
        return
    end

    if isManualMovement() then
        return
    end

    local distance =
        getHorizontalDistance(
            root,
            jumpDownAnchorCFrame
        )

    if distance >
        JUMP_DOWN_POSITION_TOLERANCE
    then
        local _, yaw =
            jumpDownAnchorCFrame:ToOrientation()

        local currentY =
            root.Position.Y

        pcall(function()
            root.CFrame =
                CFrame.new(
                    jumpDownAnchorCFrame.Position.X,
                    currentY,
                    jumpDownAnchorCFrame.Position.Z
                )
                *
                CFrame.Angles(
                    0,
                    yaw,
                    0
                )

            root.AssemblyAngularVelocity =
                Vector3.zero

            root.AssemblyLinearVelocity =
                Vector3.new(
                    0,
                    root.AssemblyLinearVelocity.Y,
                    0
                )
        end)
    end
end

local function isBadState(state)
    return state ==
        Enum.HumanoidStateType.Ragdoll
        or
        state ==
        Enum.HumanoidStateType.FallingDown
        or
        state ==
        Enum.HumanoidStateType.PlatformStanding
end

local function protectRagdoll(character)
    if not Config.AntiRagdoll then
        return
    end

    if not character then
        return
    end

    local hum =
        character:FindFirstChildOfClass(
            "Humanoid"
        )

    if not hum then
        return
    end

    pcall(function()
        hum:SetStateEnabled(
            Enum.HumanoidStateType.Ragdoll,
            false
        )

        hum:SetStateEnabled(
            Enum.HumanoidStateType.FallingDown,
            false
        )

        hum:SetStateEnabled(
            Enum.HumanoidStateType.PlatformStanding,
            false
        )

        hum.PlatformStand = false

        if isBadState(
            hum:GetState()
        ) then
            hum:ChangeState(
                Enum.HumanoidStateType.GettingUp
            )
        end
    end)
end

local function restoreRagdoll(character)
    if not character then
        return
    end

    local hum =
        character:FindFirstChildOfClass(
            "Humanoid"
        )

    if not hum then
        return
    end

    pcall(function()
        hum:SetStateEnabled(
            Enum.HumanoidStateType.Ragdoll,
            true
        )

        hum:SetStateEnabled(
            Enum.HumanoidStateType.FallingDown,
            true
        )

        hum:SetStateEnabled(
            Enum.HumanoidStateType.PlatformStanding,
            true
        )
    end)
end

local function startAntiRagdoll()
    if antiRagdollRunning then
        return
    end

    antiRagdollRunning = true

    protectRagdoll(
        getCharacter()
    )

    antiRagdollCharacterConnection =
        addConnection(
            LP.CharacterAdded,
            function(character)
                if not antiRagdollRunning then
                    return
                end

                task.wait(0.15)

                if antiRagdollRunning then
                    protectRagdoll(character)
                end
            end
        )
end

local function stopAntiRagdoll()
    antiRagdollRunning = false

    if antiRagdollCharacterConnection then
        pcall(function()
            antiRagdollCharacterConnection:Disconnect()
        end)

        antiRagdollCharacterConnection = nil
    end

    restoreRagdoll(
        getCharacter()
    )
end

local storedMaxHealth = 100
local storedRequiresNeck = true

local function protectDeath(character)
    if not antiDieRunning then
        return
    end

    if not character then
        return
    end

    local hum =
        character:FindFirstChildOfClass(
            "Humanoid"
        )

    if not hum then
        return
    end

    pcall(function()
        storedMaxHealth =
            hum.MaxHealth

        storedRequiresNeck =
            hum.RequiresNeck

        hum.RequiresNeck = false
        hum.MaxHealth = math.huge
        hum.Health = math.huge

        hum:SetStateEnabled(
            Enum.HumanoidStateType.Dead,
            false
        )
    end)
end

local function restoreDeath(character)
    if not character then
        return
    end

    local hum =
        character:FindFirstChildOfClass(
            "Humanoid"
        )

    if not hum then
        return
    end

    pcall(function()
        hum.RequiresNeck =
            storedRequiresNeck

        if storedMaxHealth ~=
            math.huge
            and
            storedMaxHealth > 0
        then
            hum.MaxHealth =
                storedMaxHealth

            if hum.Health >
                storedMaxHealth
            then
                hum.Health =
                    storedMaxHealth
            end
        end

        hum:SetStateEnabled(
            Enum.HumanoidStateType.Dead,
            true
        )
    end)
end

local function startAntiDie()
