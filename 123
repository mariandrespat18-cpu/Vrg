        settingsWindow.AbsoluteSize

    local x =
        mainPosition.X +
        mainSize.X +
        9

    local y =
        mainPosition.Y

    if
        x +
        settingsSize.X >
        viewport.X - 8
    then
        x =
            mainPosition.X -
            settingsSize.X -
            9
    end

    if x < 8 then
        x = 8
    end

    if
        y +
        settingsSize.Y >
        viewport.Y - 8
    then
        y =
            viewport.Y -
            settingsSize.Y -
            8
    end

    if y < 8 then
        y = 8
    end

    settingsWindow.Position =
        UDim2.new(
            0,
            math.floor(x),
            0,
            math.floor(y)
        )
end

local function setSettingsVisible(
    state
)
    settingsVisible =
        state

    if state then
        settingsGui.Enabled =
            true

        settingsScale.Scale =
            0.90

        task.defer(
            positionSettings
        )

        playTween(
            settingsScale,
            TweenInfo.new(
                0.28,
                Enum.EasingStyle.Quint,
                Enum.EasingDirection.Out
            ),
            {
                Scale = 1
            }
        )
    else
        playTween(
            settingsScale,
            TweenInfo.new(
                0.18,
                Enum.EasingStyle.Quad,
                Enum.EasingDirection.In
            ),
            {
                Scale = 0.94
            }
        )

        task.delay(
            0.18,
            function()
                if
                    not settingsVisible
                then
                    settingsGui.Enabled =
                        false

                    settingsScale.Scale =
                        1
                end
            end
        )
    end
end

