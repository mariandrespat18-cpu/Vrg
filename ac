--==================================================
-- ARRASTRE TOKITO
--==================================================

local dragging=false
local dragStart=nil
local startPosition=nil
local activeTouch=nil

toolsFrame.InputBegan:Connect(
    function(input)

        if input.UserInputType==
            Enum.UserInputType.MouseButton1
            or
            input.UserInputType==
            Enum.UserInputType.Touch then

            dragging=true

            dragStart=
                input.Position

            startPosition=
                toolsFrame.Position

            if input.UserInputType==
                Enum.UserInputType.Touch then

                activeTouch=input
            end
        end
    end
)

UserInputService.InputChanged:Connect(
    function(input)

        if not dragging then
            return
        end

        -- PC
        if input.UserInputType==
            Enum.UserInputType.MouseMovement then

            local delta=
                input.Position-
                dragStart

            toolsFrame.Position=
                UDim2.new(
                    startPosition.X.Scale,
                    startPosition.X.Offset+
                        delta.X,

                    startPosition.Y.Scale,
                    startPosition.Y.Offset+
                        delta.Y
                )
        end
    end
)

UserInputService.TouchMoved:Connect(
    function(touch)

        if not dragging then
            return
        end

        if touch~=activeTouch then
            return
        end

        local delta=
            touch.Position-
            dragStart

        toolsFrame.Position=
            UDim2.new(
                startPosition.X.Scale,
                startPosition.X.Offset+
                    delta.X,

                startPosition.Y.Scale,
                startPosition.Y.Offset+
                    delta.Y
            )
    end
)

UserInputService.InputEnded:Connect(
    function(input)

        if input.UserInputType==
            Enum.UserInputType.MouseButton1 then

            if dragging then

                dragging=false

                saveTokitoPosition(
                    toolsFrame.Position
                )
            end

        elseif input.UserInputType==
            Enum.UserInputType.Touch then

            if input~=activeTouch then
                return
            end

            if dragging then

                dragging=false
                activeTouch=nil

                saveTokitoPosition(
                    toolsFrame.Position
                )
            end
        end
    end
)

