--==================================================
-- SPAM OWNER
--==================================================

spamBaseBtn.MouseButton1Click:Connect(
    function()

        local char=
            LocalPlayer.Character

        local hrp=
            char
            and char:FindFirstChild(
                "HumanoidRootPart"
            )

        if not hrp then
            return
        end

        local nearestPlot=nil
        local nearestDist=math.huge

        local Plots=
            Workspace:FindFirstChild(
                "Plots"
            )

        if Plots then

            for _,plot in ipairs(
                Plots:GetChildren()
            ) do

                local sign=
                    plot:FindFirstChild(
                        "PlotSign"
                    )

                if sign then

                    local yourBase=
                        sign:FindFirstChild(
                            "YourBase"
                        )

                    if not yourBase
                        or not yourBase.Enabled then

                        local signPos=
                            sign:IsA("BasePart")
                            and sign.Position
                            or
                            (
                                sign.PrimaryPart
                                and
                                sign.PrimaryPart.Position
                            )

                        if not signPos then

                            local part=
                                sign:FindFirstChildWhichIsA(
                                    "BasePart",
                                    true
                                )

                            signPos=
                                part
                                and
                                part.Position
                        end

                        if signPos then

                            local dist=
                                (
                                    hrp.Position-
                                    signPos
                                ).Magnitude

                            if dist<nearestDist then

                                nearestDist=
                                    dist

                                nearestPlot=
                                    plot
                            end
                        end
                    end
                end
            end
        end

        if not nearestPlot then
            return
        end

        local targetPlayer=nil

        local sign=
            nearestPlot:FindFirstChild(
                "PlotSign"
            )

        local textLabel=
            sign
            and sign:FindFirstChild(
                "SurfaceGui"
            )
            and sign.SurfaceGui:FindFirstChild(
                "Frame"
            )
            and sign.SurfaceGui.Frame:FindFirstChild(
                "TextLabel"
            )

        if textLabel then

            local baseText=
                textLabel.Text

            local nickname=
                baseText
                and baseText:match(
                    "^(.-)'"
                )
                or baseText

            if nickname then

                for _,p in ipairs(
                    Players:GetPlayers()
                ) do

                    if p.DisplayName==
                        nickname
                        or
                        p.Name==
                        nickname then

                        targetPlayer=p
                        break
                    end
                end
            end
        end

        if not targetPlayer then

            local plots=
                Workspace:FindFirstChild(
                    "Plots"
                )

            if not plots then
                return
            end

            local myPlot

            local lpName=
                LocalPlayer.Name:lower()

            local lpDisplay=
                LocalPlayer.DisplayName:lower()

            for _,p in pairs(
                plots:GetChildren()
            ) do

                local sign=
                    p:FindFirstChild(
                        "PlotSign"
                    )

                local lbl=
                    sign
                    and sign:FindFirstChild(
                        "TextLabel",
                        true
                    )

                if lbl
                    and
                    (
                        lbl.Text:lower():find(
                            lpName
                        )
                        or
                        lbl.Text:lower():find(
                            lpDisplay
                        )
                    ) then

                    myPlot=p
                    break
                end
            end

            local nearestOwnerPlot
            local nearestOwnerDist=
                math.huge

            for _,p in pairs(
                plots:GetChildren()
            ) do

                if p~=myPlot then

                    local sign=
                        p:FindFirstChild(
                            "PlotSign"
                        )

                    local part=
                        sign
                        and sign:FindFirstChildWhichIsA(
                            "BasePart",
                            true
                        )

                    if part then

                        local dist=
                            (
                                hrp.Position-
                                part.Position
                            ).Magnitude

                        if dist<
                            nearestOwnerDist then

                            nearestOwnerDist=
                                dist

                            nearestOwnerPlot=
                                p
                        end
                    end
                end
            end

            if nearestOwnerPlot then

                local sign=
                    nearestOwnerPlot:FindFirstChild(
                        "PlotSign"
                    )

                local lbl=
                    sign
                    and sign:FindFirstChild(
                        "TextLabel",
                        true
                    )

                if lbl then

                    local txt=
                        lbl.Text:lower()

                    for _,p in ipairs(
                        Players:GetPlayers()
                    ) do

                        if p~=LocalPlayer then

                            if txt:find(
                                p.Name:lower()
                            )
                            or
                            txt:find(
                                p.DisplayName:lower()
                            ) then

                                targetPlayer=p
                                break
                            end
                        end
                    end
                end
            end
        end

        if not targetPlayer
            or targetPlayer==LocalPlayer then

            return
        end

        spamBaseBtn.BackgroundColor3=
            Theme.Accent1

        spamBaseBtn.TextColor3=
            Color3.new(
                0,
                0,
                0
            )

        task.spawn(
            function()

                for _,cmd in ipairs(
                    ALL_COMMANDS
                ) do

                    if not isOnCooldown(cmd) then

                        pcall(
                            runAdminCommand,
                            targetPlayer,
                            cmd
                        )

                        activeCooldowns[cmd]=
                            tick()
                    end

                    task.wait(0.15)
                end

                task.wait(0.2)

                spamBaseBtn.BackgroundColor3=
                    Theme.SurfaceHighlight

                spamBaseBtn.TextColor3=
                    Theme.TextPrimary
            end
        )
    end
)

--==================================================
-- PROX AP
--==================================================

local ProximityAPActive=false
local proximityRange=25

local circleAdornment=
    Instance.new(
        "CylinderHandleAdornment"
    )

circleAdornment.Name=
    "ProxRadius"

circleAdornment.Radius=
    proximityRange

circleAdornment.Height=
    0.05

circleAdornment.Color3=
    Theme.Accent1

circleAdornment.Transparency=
    0.6

circleAdornment.CFrame=
    CFrame.new(
        0,
        -2.9,
        0
    )
    *
    CFrame.Angles(
        math.rad(90),
        0,
        0
    )

circleAdornment.AlwaysOnTop=false
circleAdornment.Visible=false
circleAdornment.Parent=
    toolsGui

task.spawn(
    function()

        while true do

            task.wait(0.2)

            if ProximityAPActive then

                local myChar=
                    LocalPlayer.Character

                if myChar
                    and
                    myChar:FindFirstChild(
                        "HumanoidRootPart"
                    ) then

                    circleAdornment.Adornee=
                        myChar.HumanoidRootPart

                    circleAdornment.Visible=
                        true

                    for _,p in ipairs(
                        Players:GetPlayers()
                    ) do

                        if p~=LocalPlayer
                            and p.Character
                            and
                            p.Character:FindFirstChild(
                                "HumanoidRootPart"
                            ) then

                            local dist=
                                (
                                    p.Character.HumanoidRootPart.Position
                                    -
                                    myChar.HumanoidRootPart.Position
                                ).Magnitude

                            if dist<=
                                proximityRange then

                                for _,cmd in ipairs(
                                    ALL_COMMANDS
                                ) do

                                    if not isOnCooldown(
                                        cmd
                                    ) then

                                        pcall(
                                            runAdminCommand,
                                            p,
                                            cmd
                                        )

                                        activeCooldowns[cmd]=
                                            tick()
                                    end

                                    task.wait(0.05)
                                end
                            end
                        end
                    end

                else

                    circleAdornment.Visible=
                        false
                end

            else

                circleAdornment.Visible=
                    false
            end
        end
    end
)

local function jack()

    proxBtn.Text=
        "PROX AP: "
        ..
        (
            ProximityAPActive
            and "ON"
            or "OFF"
        )

    proxBtn.BackgroundColor3=
        ProximityAPActive
        and Theme.Accent1
        or Theme.SurfaceHighlight

    proxBtn.BackgroundTransparency=
        ProximityAPActive
        and 0
        or 0.55

    proxBtn.TextColor3=
        ProximityAPActive
        and Color3.new(0,0,0)
        or Theme.TextPrimary
end

proxBtn.MouseButton1Click:Connect(
    function()

        ProximityAPActive=
            not ProximityAPActive

        jack()
    end
)

jack()
