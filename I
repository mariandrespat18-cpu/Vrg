--==================================================
-- FLING
-- Exact IY-style implementation
--==================================================

local function stopFling()

	flinging = false

	if flingDied then
		pcall(function()
			flingDied:Disconnect()
		end)

		flingDied = nil
	end

	task.wait(0.1)

	local speakerChar = getLocalCharacter()
	local root = getRoot(speakerChar)

	if speakerChar and root then

		for _, v in ipairs(speakerChar:GetDescendants()) do

			if v:IsA("BasePart") then

				v.CustomPhysicalProperties =
					PhysicalProperties.new(0.7, 0.3, 0.5)

				v.Massless = false
				v.Velocity = Vector3.zero

			elseif v:IsA("BodyAngularVelocity") then
				v:Destroy()
			end
		end
	end

	if not noclipEnabled and not walkflinging then
		setLocalNoclip(false)
	end

	flingButton.Text = "FLING: OFF"
end

local function startFling()

	if flinging then
		return
	end

	local speakerChar = getLocalCharacter()
	local root = getRoot(speakerChar)
	local humanoid = getHumanoid(speakerChar)

	if not speakerChar or not root or not humanoid then
		return
	end

	setLocalNoclip(true)

	for _, child in ipairs(speakerChar:GetDescendants()) do

		if child:IsA("BasePart") then
			child.CustomPhysicalProperties =
				PhysicalProperties.new(100, 0.3, 0.5)
		end
	end

	task.wait(0.1)

	local bambam = Instance.new("BodyAngularVelocity")

	bambam.Name = tostring(
		math.random(100000, 999999999)
	)

	bambam.Parent = root
	bambam.AngularVelocity = Vector3.new(0, 99999, 0)
	bambam.MaxTorque = Vector3.new(0, math.huge, 0)
	bambam.P = math.huge

	for _, v in ipairs(speakerChar:GetChildren()) do

		if v:IsA("BasePart") then
			v.Massless = true
			v.Velocity = Vector3.zero
		end
	end

	flinging = true
	flingButton.Text = "FLING: ON"

	flingDied = humanoid.Died:Connect(function()
		stopFling()
	end)

	task.spawn(function()

		while flinging do

			if not bambam.Parent then
				break
			end

			bambam.AngularVelocity =
				Vector3.new(0, 99999, 0)

			task.wait(0.2)

			if not flinging then
				break
			end

			bambam.AngularVelocity =
				Vector3.new(0, 0, 0)

			task.wait(0.1)
		end

		if not flinging then
			pcall(function()
				bambam:Destroy()
			end)
		end
	end)
end

--==================================================
-- WALKFLING
-- Exact IY-style implementation
--==================================================

local function stopWalkFling()

	walkflinging = false

	if walkFlingDied then
		pcall(function()
			walkFlingDied:Disconnect()
		end)

		walkFlingDied = nil
	end

	if not noclipEnabled and not flinging then
		setLocalNoclip(false)
	end

	walkFlingButton.Text = "WALKFLING: OFF"
end

local function startWalkFling()

	if walkflinging then
		return
	end

	local speakerChar = getLocalCharacter()
	local humanoid = getHumanoid(speakerChar)

	if not speakerChar or not humanoid then
		return
	end

	setLocalNoclip(true)

	walkflinging = true
	walkFlingButton.Text = "WALKFLING: ON"

	walkFlingDied = humanoid.Died:Connect(function()
		stopWalkFling()
	end)

	task.spawn(function()

		repeat

			RunService.Heartbeat:Wait()

			if not walkflinging then
				break
			end

			local character = getLocalCharacter()
			local root = getRoot(character)

			local vel
			local movel = 0.1

			while not (
				character
				and character.Parent
				and root
				and root.Parent
			) do

				if not walkflinging then
					return
				end

				RunService.Heartbeat:Wait()

				character = getLocalCharacter()
				root = getRoot(character)
			end

			vel = root.Velocity

			root.Velocity =
				vel * 10000 +
				Vector3.new(0, 10000, 0)

			RunService.RenderStepped:Wait()

			if character
				and character.Parent
				and root
				and root.Parent then

				root.Velocity = vel
			end

			RunService.Stepped:Wait()

			if character
				and character.Parent
				and root
				and root.Parent then

				root.Velocity =
					vel +
					Vector3.new(0, movel, 0)

				movel = movel * -1
			end

		until walkflinging == false
	end)
end

--==================================================
-- ANTIFLING
-- Exact IY behavior
--==================================================

local function stopAntiFling()

	if antifling then
		antifling:Disconnect()
		antifling = nil
	end

	antiFlingButton.Text = "ANTIFLING: OFF"
end

local function startAntiFling()

	if antifling then
		antifling:Disconnect()
		antifling = nil
	end

	antifling = RunService.Stepped:Connect(function()

		for _, player in pairs(Players:GetPlayers()) do

			if player ~= LocalPlayer
				and player.Character then

				for _, v in pairs(
					player.Character:GetDescendants()
				) do

					if v:IsA("BasePart") then
						v.CanCollide = false
					end
				end
			end
		end
	end)

	antiFlingButton.Text = "ANTIFLING: ON"
end

