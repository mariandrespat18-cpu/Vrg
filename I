--==================================================
-- PLAYER EVENTS
--==================================================

Players.PlayerAdded:Connect(function()

	if listOpen then
		refresh()
	end
end)

Players.PlayerRemoving:Connect(function(plr)

	if selectedPlayer == plr then
		selectedPlayer = nil
		selectedLabel.Text = "Seleccionado: Ninguno"
	end

	if listOpen then
		refresh()
	end
end)

--==================================================
-- RESPAWN
--==================================================

LocalPlayer.CharacterAdded:Connect(function(character)

	task.wait(0.35)

	applySpeed()

	if noclipEnabled then
		setLocalNoclip(true)
	end

	if flinging then
		flinging = false
		startFling()
	end

	if walkflinging then
		walkflinging = false
		startWalkFling()
	end
end)

--==================================================
-- MAIN LOOP
--==================================================

RunService.Heartbeat:Connect(function()

	if infTpEnabled and selectedPlayer then

		local myRoot = getLocalRoot()
		local targetRoot = getRoot(
			getCharacter(selectedPlayer)
		)

		if myRoot and targetRoot then

			myRoot.CFrame =
				targetRoot.CFrame *
				CFrame.new(2, 0, 2)
		end
	end

	if noclipEnabled then
		setLocalNoclip(true)
	end

	applySpeed()
end)

--==================================================
-- INITIALIZE
--==================================================

refresh()
updateSize()
